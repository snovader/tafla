// Generic shapes of tables: a point of scalars and a string, a document
// whose header nests a table of columns, a list of small nested tables, a
// fixed-size sample, and a task of enums.

/// A small table of two coordinates, an identifier and a name
message Point {
    x: float64;
    y: float64;
    id: int64;
    name: string;
}

/// A document, whose header holds its length and version, with a nested
/// table of columns of the same length
message Document (sized, version: 1) {
    x: float64;
    y: float64;
    name: string;
    columns: Columns;
}

/// Columns with a value per key
table Columns {
    /// The value that `keys` count from
    base: int64;
    keys: [uint32];
    a: [float32];
    b: [float32];
}

/// A list of items, each a table of its own
message ItemList {
    items: [Item];
}

table Item {
    value: float32;
    pair: Pair;
}

/// Two values of an item
table Pair {
    first: float32;
    second: float32;
}

/// A fixed-size sample, such as a stream sends one per frame
struct Sample {
    key: uint32;
    a: float32;
    b: float32;
}

/// A task, whose fields are enums, alone, in an array and in a struct
message Task {
    priority: Priority;
    /// The states that the task has been in, the oldest first
    history: [State];
    step: Step;
    name: string;
}

/// A state and how long the task has been in it
struct Step {
    state: State;
    priority: Priority;
    seconds: uint32;
}

/// How soon to do a task
enum Priority: int8 {
    low = -1;
    normal = 0;
    high = 1;
}

/// What has become of a task
enum State: uint16 {
    waiting = 0;
    running = 1;
    done = 2;
    failed = 1000;
}
