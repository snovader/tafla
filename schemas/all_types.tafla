// Every type of field: each scalar alone and as an array, strings, vectors
// of strings, nested tables, vectors of tables, structs alone, as fields, in
// arrays and within other structs, and enums of every integer type, as
// fields, in arrays, in structs and in the tables of a vector, with doc
// comments on each kind of declaration and field names that are keywords in
// some target language.

/// A field of every scalar type, and a bool
message Scalars {
    int8: int8;
    uint8: uint8;
    int16: int16;
    uint16: uint16;
    int32: int32;
    uint32: uint32;
    int64: int64;
    uint64: uint64;
    float32: float32;
    float64: float64;
    bool: bool;
}

/// An array of every scalar type but bool, which has none
message Arrays {
    int8: [int8];
    uint8: [uint8];
    int16: [int16];
    uint16: [uint16];
    int32: [int32];
    uint32: [uint32];
    int64: [int64];
    uint64: [uint64];
    float32: [float32];
    float64: [float64];
}

/// Tables nested in tables, by field and in vectors
message Nested {
    /// A string beside the tables
    label: string;
    /// The first of three levels of tables
    outer: Outer;
    /// A vector of tables that hold vectors of themselves
    trees: [Tree];
}

table Outer {
    count: uint32;
    inner: Inner;
}

table Inner {
    name: string;
    values: [float64];
}

/// A table that holds a vector of its own type, which a vector can since it
/// may be empty
table Tree {
    value: int32;
    children: [Tree];
}

/// Fields named after keywords of TypeScript, Python, Java or Rust
table Keywords {
    class: uint8;
    default: uint8;
    in: uint8;
    match: uint8;
    self: uint8;
    type: string;
}

/// A message that nests the table of keywords, so that it's written
message Reserved {
    keywords: Keywords;
}

/// Vectors of strings beside other fields, in a nested table and in the
/// items of a vector
message StringVectors {
    id: uint32;
    /// A vector of strings, whose getter reads each string when it's asked
    /// for
    tags: [string];
    labels: Labels;
    entries: [Entry];
}

/// A nested table whose only field is a vector of strings
table Labels {
    values: [string];
}

/// An item of a vector, which holds a string and a vector of strings
table Entry {
    key: string;
    aliases: [string];
}

/// A vector of strings in a message of `uint16` offsets, before a scalar
message NarrowStringVectors (offset_type: uint16) {
    names: [string];
    count: uint8;
}

/// Structs as fields, in place like scalars, and in arrays, which are aligned
/// to their structs' largest scalar
message Structs {
    /// A struct of every scalar type
    packed: Packed;
    /// An array of structs of 7 bytes, aligned to 4
    documented: [Documented];
    /// A struct of structs
    segment: Segment;
    segments: [Segment];
    /// A table nested in the message, which holds structs too
    path: Path;
}

table Path {
    start: Point;
    points: [Point];
}

/// Two points, whose scalars lie in the segment's place
struct Segment {
    start: Point;
    end: Point;
}

struct Point {
    x: float32;
    y: float32;
}

/// A struct of every scalar type and a bool, at fixed offsets without
/// padding
struct Packed {
    int8: int8;
    uint8: uint8;
    int16: int16;
    uint16: uint16;
    int32: int32;
    uint32: uint32;
    int64: int64;
    uint64: uint64;
    float32: float32;
    float64: float64;
    bool: bool;
}

// A comment, which the generated code leaves out
//// A comment of four slashes, which isn't documentation either

/// Documentation of several lines.
///
/// It can hold Markdown's `code spans`, non-ASCII text such as å, 世界 and
/// 🦀, and text that closes a comment or string in some language: */, """,
/// a backslash \ and a trailing quote"
///
/// Javadoc and `JSDoc` read it as text, with HTML's <b>, &amp; and &,
/// Javadoc's {@link Object} and `{@code x}`, Java's Unicode escape \u000A,
/// and a tag at the start of a line:
/// @deprecated
struct Documented {
    /// A field's documentation, of one line
    one: uint8;
    /// A field's documentation,
    /// of two lines
    two: uint16;
    undocumented: uint32;
}

/// Enums as fields and in arrays, which are stored as their integer types
message Enums {
    /// An enum of one byte
    level: Level;
    /// An array of enums, which is an array of their integer type
    levels: [Level];
    direction: Direction;
    directions: [Direction];
    unit: Unit;
    units: [Unit];
    change: Change;
    changes: [Change];
    status: Status;
    statuses: [Status];
    sign: Sign;
    signs: [Sign];
    mask: Mask;
    masks: [Mask];
    extent: Extent;
    extents: [Extent];
    /// An enum whose values are keywords
    word: Word;
    /// A struct of enums
    mark: Mark;
    marks: [Mark];
    /// Tables of an enum, which a vector's view reads
    steps: [Step];
}

/// A table of an enum, a struct of enums and a string
table Step {
    level: Level;
    mark: Mark;
    name: string;
}

/// A struct of enums of 1, 2 and 8 bytes beside a scalar, and of a struct
/// that holds an enum
struct Mark {
    level: Level;
    change: Change;
    weight: float32;
    extent: Extent;
    turn: Turn;
}

struct Turn {
    direction: Direction;
    mask: Mask;
}

/// How much of something there is.
///
/// A field of it holds any `uint8`, whether it has a name here or not.
enum Level: uint8 {
    /// The least
    low = 0;
    medium = 1;
    /// The most, in documentation
    /// of two lines
    high = 2;
}

/// An enum of `int8`, with a negative value
enum Direction: int8 {
    backward = -1;
    none = 0;
    forward = 1;
    /// The least `int8`
    furthest_back = -128;
}

/// An enum of `uint16`, whose values aren't in order
enum Unit: uint16 {
    last = 65535;
    first = 0;
    v_2 = 2;
}

enum Change: int16 {
    least = -32768;
    greatest = 32767;
}

enum Status: uint32 {
    ok = 0;
    not_found = 404;
    greatest = 4294967295;
}

enum Sign: int32 {
    least = -2147483648;
    greatest = 2147483647;
}

/// An enum of `uint64`, with a value that a float64 can't hold exactly
enum Mask: uint64 {
    none = 0;
    one = 1;
    beyond_float64 = 9007199254740993;
    all = 18446744073709551615;
}

enum Extent: int64 {
    least = -9223372036854775808;
    zero = 0;
    greatest = 9223372036854775807;
}

/// Values named after keywords and literals of the target languages
enum Word: uint8 {
    class = 0;
    default = 1;
    in = 2;
    match = 3;
    self = 4;
    type = 5;
    true = 6;
    null = 7;
    none = 8;
    init = 9;
    new = 10;
    name = 11;
    value = 12;
}
