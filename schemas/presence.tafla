// Optional fields, and fields that later versions of a message and later
// revisions of a table append. The messages and tables named `V1` are the first
// version or revision of the others, whose bytes the tests read with them.
// A scalar that may be missing reads as its default, zero unless the schema
// gives one after `=`.

/// A record in its second version, which reads the first too
message Record (sized, version: 2, since: 1) {
    id: uint32;
    name: string?;
    values: [float64]?;
    origin: Point?;
    flag: bool? = true;
    entries: [Entry]?;
    /// A total, -1 when it's absent
    total: int64? = -1;
    /// Added by version 2
    label: string (since: 2);
    extent: Extent? (since: 2);
}

/// The first version of a record
message RecordV1 (sized, version: 1) {
    id: uint32;
    name: string?;
    values: [float64]?;
    origin: PointV1?;
    flag: bool? = true;
    entries: [EntryV1]?;
    total: int64? = -1;
}

/// A point whose second revision appends `z` and `label`
table Point {
    x: float64;
    y: float64;
    z: float64 = -0.5 (since: 2);
    /// An optional field of a nested table, which its reader finds absent at
    /// the table's position rather than at 0
    label: string? (since: 2);
}

table PointV1 {
    x: float64;
    y: float64;
}

/// An item of a record, with an optional note, whose second revision
/// appends `weight`
table Entry {
    key: uint16;
    note: string?;
    weight: float32 = 0.1 (since: 2);
}

table EntryV1 {
    key: uint16;
    note: string?;
}

struct Extent {
    width: float32;
    height: float32;
}

/// A message without a version, whose second revision appends `count`
message Sample {
    key: uint32;
    count: uint16 = 7 (since: 2);
}

message SampleV1 {
    key: uint32;
}

/// A level of a graded message
enum Level: uint8 {
    low = 0;
    /// The default of a graded message's level
    high = 2;
}

/// A message of an optional enum, an optional array of it, and an enum that
/// its second revision appended, each of which reads as a value of the enum
/// where the message lacks it
message Graded {
    grade: uint8;
    level: Level? = 2;
    levels: [Level]?;
    floor: Level (since: 2);
}
