{
  "name": "tafla",
  "version": "0.0.0",
  "description": "Binary tables of scalars, strings and typed arrays, read with bounds checks and zero-copy views",
  "keywords": [
    "binary",
    "buffer",
    "serialization",
    "table",
    "typed array",
    "zero-copy"
  ],
  "license": "MIT",
  "author": "snovader",
  "homepage": "https://github.com/snovader/tafla/tree/main/typescript/core#readme",
  "bugs": {
    "url": "https://github.com/snovader/tafla/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snovader/tafla.git",
    "directory": "typescript/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "tafla-source": "./source/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#*": {
      "tafla-source": "./source/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "imports": {
      "#*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p ./tsconfig.dist.json",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
