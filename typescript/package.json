{
  "name": "tafla-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "benchmarks",
    "core"
  ],
  "scripts": {
    "bench": "vitest bench --run --reporter=verbose",
    "bench:compare": "node --conditions=tafla-source benchmarks/comparison/main.ts",
    "conformance:generate": "node --conditions=tafla-source core/test/conformance/generate.ts && node --conditions=tafla-source core/test/generated/generate.ts",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:write": "oxlint --fix",
    "package:check": "yarn workspace tafla pack -o ../.cache/tafla.tgz && attw --profile esm-only .cache/tafla.tgz && publint core && node core/test/dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
