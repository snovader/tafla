{
  "name": "tafla-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "benchmarks",
    "core",
    "native"
  ],
  "scripts": {
    "bench": "node bundle.ts node --conditions=tafla-bundle benchmarks/fields/main.ts",
    "bench:native": "yarn workspace @tafla/native build && node bundle.ts node --conditions=tafla-bundle benchmarks/native/main.ts",
    "bench:compare": "node bundle.ts node --conditions=tafla-bundle benchmarks/comparison/main.ts",
    "conformance:generate": "node --conditions=tafla-source core/test/conformance/generate.ts && node --conditions=tafla-source core/test/generated/generate.ts",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:write": "oxlint --fix",
    "package:check": "yarn workspace tafla build && node core/test/dist.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rolldown": "~1.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
