{
  "name": "tafla-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "benchmarks",
    "core"
  ],
  "scripts": {
    "bench": "node bundle.ts node --conditions=tafla-bundle benchmarks/fields/main.ts",
    "bench:compare": "node bundle.ts node --conditions=tafla-bundle benchmarks/comparison/main.ts",
    "conformance:generate": "node --conditions=tafla-source core/test/conformance/generate.ts && node --conditions=tafla-source core/test/generated/generate.ts",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:write": "oxlint --fix",
    "package:check": "yarn workspace tafla build && node core/test/dist.ts",
    "test": "node bundle.ts node --conditions=tafla-bundle --test --test-isolation=none 'core/test/**/!(bigEndian).test.ts' 'lint/*.test.ts' && node --conditions=tafla-source --experimental-test-module-mocks --test core/test/bigEndian.test.ts",
    "test:watch": "node --conditions=tafla-source --experimental-test-module-mocks --test --watch 'core/test/**/*.test.ts' 'lint/*.test.ts'",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rolldown": "^1.3.2",
    "typescript": "^7.0.2"
  }
}
