.idea

# TypeScript
node_modules
# The declarations and build info of tsc -b, which the tsconfigs' outDir sets
/typescript/.cache
/typescript/core/.bundle
/typescript/**/dist
/typescript/.yarn/*
!/typescript/.yarn/patches
!/typescript/.yarn/plugins
!/typescript/.yarn/releases
!/typescript/.yarn/sdks
!/typescript/.yarn/versions
# The native addon, which typescript/native/build.ts builds
/typescript/native/target
/typescript/native/*.node

# Python
__pycache__
.hypothesis
.ruff_cache
/python/.venv
/python/**/dist
/python/results.json
# The native module, which an editable install builds into the package
/python/core/src/tafla/_native.*.so
/python/core/src/tafla/_native.*.pyd
/python/core/native/target

# Java
.jqwik-database
/java/.gradle
/java/**/bin
/java/**/build

# Rust
/rust/**/target

# Swift: SwiftPM's build directory and Xcode's package workspace, for the
# manifest at the root
/.build
/.swiftpm
