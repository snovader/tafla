<Project Sdk="Microsoft.NET.Sdk">
    <!-- The fuzz targets of the runtime's reader, which libFuzzer runs through SharpFuzz on Linux, as
         fuzz/fuzz.sh does, and which run on any host on the inputs that they're given -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- To give the instrumentation memory to record branches in, outside libFuzzer -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The tests' descriptions, which the conformance target reads with, document themselves by
             their names -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SharpFuzz" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Tafla/Tafla.csproj" />
    </ItemGroup>

    <!-- The conformance test's descriptions and reader, rather than a second model of tables -->
    <ItemGroup>
        <Compile Include="../../tests/Tafla.Tests/Tables/Cases.cs" Link="Tables/Cases.cs" />
        <Compile Include="../../tests/Tafla.Tests/Tables/Description.cs" Link="Tables/Description.cs" />
        <Compile Include="../../tests/Tafla.Tests/Tables/Read.cs" Link="Tables/Read.cs" />
        <Compile Include="../../tests/Tafla.Tests/Tables/Scalars.cs" Link="Tables/Scalars.cs" />
    </ItemGroup>

    <!-- A run out of memory throws an OutOfMemoryException, which SharpFuzz reports as a crash with
         the input that caused it, at libFuzzer's default -rss_limit_mb, 2 GiB, which bounds the other
         languages' targets. libFuzzer can't bound the memory of the .NET process itself. -->
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="2147483648" />
    </ItemGroup>
</Project>
