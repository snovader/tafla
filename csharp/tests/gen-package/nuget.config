<?xml version="1.0" encoding="utf-8"?>
<!-- Restores Tafla and Tafla.Gen only from the packages that dotnet pack wrote, even where nuget.org
     has packages of the same versions, into a folder of the test's own, from which
     scripts/test-gen-package.sh removes the ones that it restored before -->
<configuration>
    <config>
        <add key="globalPackagesFolder" value="../../artifacts/gen-package-test/packages" />
    </config>

    <packageSources>
        <clear />
        <add key="tafla" value="../../artifacts/package/release" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="tafla">
            <package pattern="Tafla" />
            <package pattern="Tafla.Gen" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
