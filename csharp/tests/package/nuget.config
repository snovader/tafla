<?xml version="1.0" encoding="utf-8"?>
<!-- Restores Tafla only from the package that dotnet pack wrote, even where nuget.org has a package
     of the same version, and the packages of Native AOT from nuget.org, into a folder of the test's
     own, from which scripts/test-package.sh removes the Tafla that it restored before -->
<configuration>
    <config>
        <add key="globalPackagesFolder" value="../../artifacts/package-test/packages" />
    </config>

    <packageSources>
        <clear />
        <add key="tafla" value="../../artifacts/package/release" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="tafla">
            <package pattern="Tafla" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
